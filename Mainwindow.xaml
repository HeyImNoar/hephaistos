                        <TabItem x:Name="DiagnosticAnalysisTab" Header="Diagnostic">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="ValidationButton"
                                        Grid.Row="0"
                                        Style="{StaticResource ButtonBaseStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,10"
                                        Content="Test recherche"
                                        ToolTip="Diagnostic de la recherche documentaire"
                                        IsEnabled="False"
                                        Click="ValidationButton_Click"/>
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Historique"
                                               VerticalAlignment="Center"
                                               Margin="2,0,10,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <ComboBox x:Name="DiagnosticHistoryComboBox"
                                              Grid.Column="1"
                                              MinWidth="220"
                                              Height="32"
                                              Padding="8,3"
                                              ItemContainerStyle="{StaticResource ThemedComboBoxItemStyle}"
                                              DisplayMemberPath="DisplayLabel"
                                              ToolTip="Retrouver les résultats précédents de cette analyse pendant la session"
                                              SelectionChanged="DiagnosticHistoryComboBox_SelectionChanged">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBoxStyle}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Style.Triggers>
                                                    <Trigger Property="HasItems" Value="True">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </Grid>
                                <TextBox x:Name="DiagnosticTextBox"
                                         Grid.Row="2"
                                         Style="{StaticResource OutputTextBoxStyle}"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         IsTabStop="False"
                                         Cursor="Arrow"
                                         PreviewMouseLeftButtonDown="OutputTextBox_PreviewMouseLeftButtonDown"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          Margin="0,6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Style="{StaticResource VerticalWorkspaceSplitterStyle}"
                          ToolTip="Faites glisser la barre pour redimensionner la zone de travail"/>

            <!-- Colonne documents et sources -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.55*" MinHeight="170"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="0.85*" MinHeight="105"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.05*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        AllowDrop="True"
                        DragOver="DocumentDropZone_DragOver"
                        Drop="DocumentDropZone_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Documents"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="Votre corpus de travail"
                                           Margin="0,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="SelectFolderButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="11,6"
                                    Content="+ Ajouter"
                                    ToolTip="Ajouter un ou plusieurs fichiers PDF"
                                    Click="SelectFolderButton_Click"/>
                        </Grid>

                        <TextBlock x:Name="FolderPathTextBox"
                                   Grid.Row="1"
                                   Margin="0,3,0,7"
                                   Text="Aucun document chargé"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Grid.Row="2"
                                MinHeight="150"
                                Padding="3"
                                AllowDrop="True"
                                DragOver="DocumentDropZone_DragOver"
                                Drop="DocumentDropZone_Drop"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="{DynamicResource SoftSurfaceBrush}">
                            <Grid>
                                <ListBox x:Name="DocumentsListBox"
                                         Padding="2"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource DocumentListItemStyle}"
                                         SelectionMode="Extended"
                                         ToolTip="Ctrl + clic ou Maj + clic pour sélectionner plusieurs documents."
                                         SelectionChanged="DocumentsListBox_SelectionChanged"
                                         MouseDoubleClick="DocumentsListBox_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DocumentName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DetailsText}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="EmptyDocumentsPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="14"
                                            IsHitTestVisible="False">
                                    <Border Width="38"
                                            Height="38"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource HealthSoftBrush}"
                                            CornerRadius="19">
                                        <TextBlock Text="+"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="23"
                                                   FontWeight="Light"
                                                   Foreground="{DynamicResource EmptyIconTextBrush}"/>
                                    </Border>
                                    <TextBlock Text="Glissez vos PDF ici"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="ou un dossier contenant des PDF"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DocumentsSelectionTextBlock"
                                   Grid.Row="3"
                                   Margin="2,7,2,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Aucun corpus chargé."/>

                        <Grid Grid.Row="4" Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FolderStatsTextBlock"
                                       Grid.Row="0"
                                       Margin="2,0,2,5"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Text="Aucun document chargé."/>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                                <Button x:Name="SelectAllDocumentsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Content="Tout sélectionner"
                                        IsEnabled="False"
                                        Click="SelectAllDocumentsButton_Click"/>
                                <Button x:Name="ClearDocumentSelectionButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="3,0,0,0"
                                        Content="Désélectionner"
                                        IsEnabled="False"
                                        Click="ClearDocumentSelectionButton_Click"/>
                                <Button x:Name="RemoveDocumentsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="3,0,0,0"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Content="− Retirer"
                                        ToolTip="Retirer les documents sélectionnés de l'espace sans supprimer les fichiers originaux"
                                        IsEnabled="False"
                                        Click="RemoveDocumentsButton_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Style="{StaticResource HorizontalWorkspaceSplitterStyle}"
                              ToolTip="Faites glisser pour redimensionner Documents et Sources"/>

                <GridSplitter Grid.Row="3"
                              Height="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Style="{StaticResource HorizontalWorkspaceSplitterStyle}"
                              ToolTip="Faites glisser pour redimensionner Sources et Extrait"/>

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="1,0,0,8">
                            <TextBlock Text="Sources utilisées"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Double-cliquez pour ouvrir le passage dans le PDF"
                                       Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="SourcesListBox"
                                     Padding="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SourceListItemStyle}"
                                     SelectionChanged="SourcesListBox_SelectionChanged"
                                     MouseDoubleClick="SourcesListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Les sources d'une réponse apparaîtront ici."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="16"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=SourcesListBox, Path=Items.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Extrait sélectionné"
                                   Margin="1,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"/>

                        <Grid Grid.Row="1">
                            <TextBox x:Name="SourcePreviewTextBox"
                                     Style="{StaticResource OutputTextBoxStyle}"
                                     FontSize="12.5"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Sélectionnez une source pour lire ici le passage utilisé."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=SourcePreviewTextBox, Path=Text.Length}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
