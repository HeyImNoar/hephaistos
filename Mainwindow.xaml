<Window x:Class="Hephaistos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Héphaïstos"
        Icon="Assets/hephaistos.ico"
        Width="1180"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#B56F4A"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#A96240"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#F5EAE3"/>
        <SolidColorBrush x:Key="InkBrush" Color="#30403D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6F7B78"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DDE2DF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#FAFBFA"/>
        <SolidColorBrush x:Key="HealthSoftBrush" Color="#EDF2EF"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F5"/>
        <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F2F4F2"/>
        <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#CBD2CE"/>
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#E9ECEA"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#8A5A51"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#EEF1EF"/>
        <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#D8DEDA"/>
        <SolidColorBrush x:Key="TabStripBrush" Color="#E9EDEA"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#CAD2CE"/>
        <SolidColorBrush x:Key="SourceHoverBrush" Color="#F6F8F6"/>
        <SolidColorBrush x:Key="SourceHoverBorderBrush" Color="#CDD5D1"/>
        <SolidColorBrush x:Key="SourceSelectedBorderBrush" Color="#DEB9A5"/>
        <SolidColorBrush x:Key="HealthBorderBrush" Color="#E1E7E3"/>
        <SolidColorBrush x:Key="HealthDotBrush" Color="#6F8E82"/>
        <SolidColorBrush x:Key="HealthTextBrush" Color="#536460"/>
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DDE4E0"/>
        <SolidColorBrush x:Key="EmptyBorderBrush" Color="#E5E9E6"/>
        <SolidColorBrush x:Key="ChatBubbleBrush" Color="#F0F3F1"/>
        <SolidColorBrush x:Key="TypingDotBrush" Color="#7E8986"/>
        <SolidColorBrush x:Key="EmptyIconTextBrush" Color="#657671"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="CancelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource TabSelectedBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource TabStripBrush}"
                                    CornerRadius="10"
                                    Padding="3"
                                    Margin="0,0,0,10">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="6">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Margin="4,4,4,8">
                                <Border HorizontalAlignment="Left"
                                        Background="{DynamicResource TabStripBrush}"
                                        CornerRadius="10"
                                        Padding="3">
                                    <TabPanel IsItemsHost="True"/>
                                </Border>
                            </ScrollViewer>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalWorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Handle"
                                    Width="3"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SplitterBrush}"
                                    CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Handle" Property="Width" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Handle" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalWorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Handle"
                                    Width="72"
                                    Height="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SplitterBrush}"
                                    CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Handle" Property="Height" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Handle" Property="Height" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <Style x:Key="OutputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DocumentListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="9,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SourceChrome"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SourceChrome" Property="Background" Value="{DynamicResource SourceHoverBrush}"/>
                                <Setter TargetName="SourceChrome" Property="BorderBrush" Value="{DynamicResource SourceHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SourceChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="SourceChrome" Property="BorderBrush" Value="{DynamicResource SourceSelectedBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock Text="Héphaïstos"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="Analyse documentaire locale"
                           Margin="0,2,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Margin="0,4,0,0"
                           FontSize="10.5"
                           Foreground="{DynamicResource MutedBrush}">
                    <Run x:Name="VersionRun" Text="beta 1.1"/>
                    <Run Text=" · créé par "/>
                    <Run Text="Noa"
                         Foreground="{DynamicResource AccentBrush}"/>
                </TextBlock>
            </StackPanel>

            <!-- Logo centré dans l’en-tête -->
            <Border Grid.Column="1"
                    Width="60"
                    Height="60"
                    Margin="16,0"
                    Padding="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                <Image Source="Assets/hephaistos-logo.png"
                       Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton"
                        Style="{StaticResource ButtonBaseStyle}"
                        Padding="10,6"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        ToolTip="Passer en mode sombre"
                        Click="ThemeToggleButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeToggleIcon"
                                   Text="☾"
                                   Margin="0,0,7,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ThemeToggleText"
                                   Text="Sombre"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AiSetupButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource ButtonBaseStyle}"
                        Padding="10,6"
                        Background="{DynamicResource HealthSoftBrush}"
                        BorderBrush="{DynamicResource HealthBorderBrush}"
                        ToolTip="Vérifier ou configurer le moteur d’IA locale"
                        Click="AiSetupButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource HealthDotBrush}"/>
                        <TextBlock Text="IA locale"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HealthTextBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- État du travail : volontairement centré pour garder Annuler à portée -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                MinWidth="430"
                MaxWidth="680"
                Margin="0,0,0,14"
                Padding="12,7"
                Background="{DynamicResource HealthSoftBrush}"
                BorderBrush="{DynamicResource HealthBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           Text="En attente de documents."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HealthTextBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <ProgressBar x:Name="WorkProgressBar"
                             Grid.Column="1"
                             Height="4"
                             Margin="12,0"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ProgressTrackBrush}"
                             BorderThickness="0"
                             Visibility="Collapsed"/>

                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Style="{StaticResource CancelButtonStyle}"
                        Margin="4,0,0,0"
                        Content="Annuler"
                        IsEnabled="False"
                        Click="CancelButton_Click"/>
            </Grid>
        </Border>

        <!-- Espace de travail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" MinWidth="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Zone principale -->
            <TabControl x:Name="ResultTabControl"
                        Grid.Column="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource ModernTabControlStyle}">

                <TabItem x:Name="ChatTab" Header="Chat">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ChatScrollViewer"
                                      Grid.Row="0"
                                      Padding="8,8,8,14"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="420"
                                        Margin="24"
                                        Padding="22,20"
                                        Background="{DynamicResource SoftSurfaceBrush}"
                                        BorderBrush="{DynamicResource EmptyBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ChatMessagesItemsControl, Path=Items.Count}"
                                                             Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="36"
                                                Height="36"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="18">
                                            <TextBlock Text="?"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="Posez une question sur votre corpus"
                                                   Margin="0,11,0,0"
                                                   TextAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Les réponses s'appuient sur les documents chargés et indiquent leurs sources."
                                                   Margin="0,5,0,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="ChatMessagesItemsControl"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Border x:Name="MessageBubble"
                                                        MaxWidth="620"
                                                        Padding="13,10"
                                                        CornerRadius="12"
                                                        Background="{DynamicResource ChatBubbleBrush}"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Sender}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   Margin="0,0,0,4"/>
                                                        <TextBlock TextWrapping="Wrap"
                                                                   FontSize="14"
                                                                   LineHeight="20"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   TextOptions.TextFormattingMode="Display"
                                                                   Loaded="ChatMessageTextBlock_Loaded"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <Border x:Name="ThinkingIndicator"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                Margin="10,3,0,3"
                                Padding="10,7"
                                CornerRadius="10"
                                Background="{DynamicResource ChatBubbleBrush}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="2" Fill="{DynamicResource TypingDotBrush}">
                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                     From="0" To="-4" Duration="0:0:0.35" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="6" Height="6" Margin="2" Fill="{DynamicResource TypingDotBrush}">
                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation BeginTime="0:0:0.12"
                                                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                     From="0" To="-4" Duration="0:0:0.35" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="6" Height="6" Margin="2" Fill="{DynamicResource TypingDotBrush}">
                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation BeginTime="0:0:0.24"
                                                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                     From="0" To="-4" Duration="0:0:0.35" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </StackPanel>
