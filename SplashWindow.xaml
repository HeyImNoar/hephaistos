<Window x:Class="Hephaistos.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Héphaïstos"
        Width="520"
        Height="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Opacity="0">
    <Window.Resources>
        <SolidColorBrush x:Key="SplashAccentBrush" Color="#B96F49"/>
        <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FAF8F4"/>
        <SolidColorBrush x:Key="SplashSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SplashInkBrush" Color="#25312D"/>
        <SolidColorBrush x:Key="SplashMutedBrush" Color="#78827E"/>
        <SolidColorBrush x:Key="SplashLineBrush" Color="#E6E1D9"/>
        <SolidColorBrush x:Key="SplashTrackBrush" Color="#EEE8DF"/>

    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.24"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{DynamicResource SplashBackgroundBrush}"
            BorderBrush="{DynamicResource SplashLineBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="34">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="7"
                              Opacity="0.18"
                              Color="#1E2925"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="92"
                        Height="92"
                        CornerRadius="22"
                        Background="{DynamicResource SplashSurfaceBrush}"
                        BorderBrush="{DynamicResource SplashLineBrush}"
                        BorderThickness="1"
                        Padding="7">
                    <Image Source="/Assets/hephaistos-logo.png"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="22,8,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Héphaïstos"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="27"
                                   Foreground="{DynamicResource SplashInkBrush}"/>
                        <Border Margin="12,4,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Background="{DynamicResource SplashTrackBrush}">
                            <TextBlock x:Name="VersionTextBlock"
                                       Text="beta 1.0"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="11"
                                       Foreground="{DynamicResource SplashMutedBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Analyse documentaire locale"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SplashMutedBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="2,12,2,10">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Préparation de votre espace…"
                           FontFamily="Segoe UI Semibold"
                           FontSize="16"
                           Foreground="{DynamicResource SplashInkBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DetailTextBlock"
                           Text="Vérification de l’IA locale"
                           Margin="0,7,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource SplashMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="LoadingTrack"
                      Height="4"
                      ClipToBounds="True"
                      Background="{DynamicResource SplashTrackBrush}">
                    <Border Width="96"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{DynamicResource SplashAccentBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoadingTranslate" X="-110"/>
                        </Border.RenderTransform>
                    </Border>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LoadingTranslate"
                                                     Storyboard.TargetProperty="X"
                                                     From="-110"
                                                     To="460"
                                                     Duration="0:0:1.05"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,11,0,0"
                           Text="créé par Noa"
                           FontSize="11"
                           Foreground="{DynamicResource SplashMutedBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
